# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# Nunca envie o .env real para o GitHub.
#
# Importante:
# - Rodando LOCAL fora do Docker: use localhost no DATABASE_URL.
# - Rodando via Docker Compose: o compose carrega este .env, mas sobrescreve
#   DATABASE_URL para usar o host postgres, que e o nome do servico Docker.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Use uma string longa e aleatoria.
JWT_SECRET="YOUR_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="1d"

# Porta em que o backend NestJS vai rodar.
PORT=3000

# URL do frontend liberada pelo CORS.
CORS_ORIGIN="http://localhost:3001"

# Local fora do Docker: normalmente http://localhost:8000.
# Dentro do Docker Compose, o compose sobrescreve para http://host.docker.internal:8000
# quando o microservico Python estiver rodando na sua maquina.
AI_SERVICE_URL="http://localhost:8000"
