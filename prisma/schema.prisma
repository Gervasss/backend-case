generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads    Lead[]
  statuses Status[]
  imoveis  Imovel[]
}

model Status {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#64748b")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@unique([ownerId, name])
  @@index([ownerId, order])
}

model Lead {
  id           String    @id @default(uuid())
  company      String
  contactName  String
  email        String?
  phone        String?
  value        Float?
  source       String?
  notes        String?
  nextFollowUp DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  statusId String
  status   Status  @relation(fields: [statusId], references: [id])
  imovel   Imovel?

  @@index([ownerId, statusId])
  @@index([ownerId, company])
}

model Imovel {
  id           String   @id @default(uuid())
  title        String
  propertyType String?
  address      String?
  city         String?
  state        String?
  price        Float?
  bedrooms     Int?
  bathrooms    Int?
  areaM2       Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leadId  String? @unique
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, city])
}
